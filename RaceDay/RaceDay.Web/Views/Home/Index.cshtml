@{
    ViewData["Title"] = "Welcome";
    ViewData["FullWidth"] = true;
}

<section class="hero">
    <div class="container">
        <p class="hero-kicker">Road running &middot; Walking &middot; Cycling</p>
        <h1 class="hero-title">Every race<br />starts here.</h1>
        <p class="hero-text">
            RaceDay brings South African road events together in one place. Find your next start line,
            enter in a few clicks and keep your race history, or run your own event without the spreadsheets.
        </p>
        <a class="btn btn-primary btn-lg me-2" asp-controller="Account" asp-action="Register">Create a free account</a>
        <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
    </div>
</section>

<section class="container py-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="rd-card h-100">
                <h2 class="card-heading">Find your next race</h2>
                <p>Browse upcoming runs, walks and cycle rides, and see every distance and category on offer.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rd-card h-100">
                <h2 class="card-heading">Enter in seconds</h2>
                <p>Pick your category and you are on the start list straight away. Follow your entries in one place.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rd-card h-100">
                <h2 class="card-heading">Track your results</h2>
                <p>See your finish times and positions after every event, and build your personal race history.</p>
            </div>
        </div>
    </div>

    <div class="rd-card rd-card-dark mt-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2 class="card-heading text-white">Organising an event?</h2>
                <p class="mb-md-0">Create events and categories, upload a banner, manage enrolments and publish results from one dashboard.</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register as an Organiser</a>
            </div>
        </div>
    </div>
</section>
